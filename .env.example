# Server-only. No DATABASE_URL / POSTGRES_URL fallback is allowed.
HOMESTAY_DATABASE_URL=postgresql://ROLE:PASSWORD@HOMESTAY_HOST/neondb?sslmode=require
MARKETING_DATABASE_URL=postgresql://ROLE:PASSWORD@MARKETING_HOST/nuxt-marketing?sslmode=require
# Leave false except during an approved maintenance window.
SITE_MAINTENANCE_MODE=false
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
JWT_SECRET_ADMIN=replace-with-long-random-string
JWT_SECRET_HOMESTAY=replace-with-long-random-string
JWT_SECRET_USER=replace-with-long-random-string
