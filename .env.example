# Server-only. No DATABASE_URL / POSTGRES_URL fallback is allowed.
HOMESTAY_DATABASE_URL=postgresql://ROLE:PASSWORD@HOMESTAY_HOST/neondb?sslmode=require
MARKETING_DATABASE_URL=postgresql://ROLE:PASSWORD@MARKETING_HOST/nuxt-marketing?sslmode=require
# Leave false except during an approved maintenance window.
SITE_MAINTENANCE_MODE=false

# Security patch: set server-only values before deployment. No insecure defaults.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
LEGACY_ADMIN_USERNAME=
LEGACY_ADMIN_PASSWORD=
LEGACY_JWT_SECRET=
HOMESTAY_JWT_SECRET=
LINE_LOGIN_CHANNEL_ID=2005661804
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGE_ACCESS_TOKEN=
LINE_SESSION_SECRET=
# Separate HTTP-referrer-restricted browser key; never expose the server key.
GOOGLE_MAPS_BROWSER_API_KEY=
